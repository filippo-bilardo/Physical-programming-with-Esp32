{
  "version": 1,
  "author": "Corso Physical Programming with ESP32",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 20,
      "left": 300,
      "attrs": {
        "color": "red"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 55,
      "left": 200,
      "rotate": 90,
      "attrs": {
        "value": "220"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 20,
      "left": -180,
      "attrs": {
        "value": "512"
      }
    }
  ],
  "connections": [
    [
      "esp:TX2",
      "$serialMonitor:RX",
      "",
      []
    ],
    [
      "esp:RX2",
      "$serialMonitor:TX",
      "",
      []
    ],
    [
      "esp:D18",
      "r1:1",
      "green",
      []
    ],
    [
      "r1:2",
      "led1:A",
      "green",
      []
    ],
    [
      "led1:C",
      "esp:GND.1",
      "black",
      []
    ],
    [
      "pot1:VCC",
      "esp:3V3",
      "red",
      []
    ],
    [
      "pot1:GND",
      "esp:GND.1",
      "black",
      []
    ],
    [
      "pot1:SIG",
      "esp:D34",
      "green",
      []
    ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
